{
  "name": "hop-video",
  "private": true,
  "version": "1.0.0",
  "description": "Vidéo HOP! pour les réseaux (Remotion)",
  "scripts": {
    "music": "python3 scripts/music.py",
    "studio": "remotion studio src/index.ts",
    "render": "npm run music && remotion render src/index.ts HopPromo out/hop-promo-fr.mp4",
    "render:he": "npm run music && remotion render src/index.ts HopPromoHe out/hop-promo-he.mp4",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@fontsource/fredoka": "5.1.0",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/rubik": "5.1.0",
    "@remotion/cli": "4.0.537",
    "@remotion/paths": "^4.0.537",
    "@remotion/transitions": "^4.0.537",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.537"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  }
}
